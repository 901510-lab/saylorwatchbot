# Копировать: mkdir -p ~/.config/saylorwatch && cp scripts/social_calendar.example.env ~/.config/saylorwatch/social_calendar.env
# Зависимости: bash scripts/setup_social_calendar.sh  (создаёт .venv-social/)

# OAuth Desktop JSON из Google Cloud Console (Calendar API включён)
GOOGLE_CALENDAR_CREDENTIALS=~/.config/saylorwatch/google_credentials.json
GOOGLE_CALENDAR_TOKEN=~/.config/saylorwatch/google_token.json
GOOGLE_CALENDAR_ID=primary

# Расписание X @paper_wallet_co (должно совпадать с .env бота на сервере)
SOCIAL_X_HANDLE=paper_wallet_co
SOCIAL_X_INTERVAL_DAYS=4
SOCIAL_X_SCHEDULE_START=2026-06-21
SOCIAL_X_TIMEZONE=Europe/Moscow
SOCIAL_X_POST_HOUR=11
PAPER_WALLET_CHANNEL=@Paper_wallet_co
