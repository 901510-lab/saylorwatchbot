# Outlook.com IMAP/SMTP — см. EMAIL_SUPPORT.md
# cp scripts/email_support.example.env scripts/email_support.env

IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USE_SSL=true
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USE_SSL=false
MAIL_USER=SaylorWatch@outlook.com
# OAuth2 IMAP (чтение) — один раз: python3 scripts/email_support_agent.py --oauth-login
MAIL_AUTH=oauth
# MAIL_PASSWORD=...   # только если MAIL_AUTH=password
OAUTH_TOKEN_FILE=scripts/.email_oauth.json

# Отправка ответов: graph (рекомендуется) | smtp | gmail | graph,gmail
# SMTP на @outlook.com часто заблокирован — используйте Graph:
#   python3 scripts/email_support_agent.py --oauth-graph
EMAIL_SEND_METHOD=graph
GRAPH_TOKEN_FILE=scripts/.email_graph_oauth.json
# Чтение: auto (Graph если есть токен, иначе IMAP) | graph | imap
MAIL_READ_METHOD=auto
# GMAIL_USER=...
STARTUP_WAIT_SECONDS=5

# Ollama (локально)
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:3b — базовая; saylorwatch-support — после scripts/setup_ollama_support_model.sh
OLLAMA_MODEL=saylorwatch-support
# или: OLLAMA_MODEL=qwen2.5:3b

# Режим: auto | draft | send | suggest
EMAIL_AGENT_MODE=auto

# Telegram: эскалации + еженедельный отчёт (не каждое письмо)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

WEEKLY_SUMMARY_WEEKDAY=0
WEEKLY_SUMMARY_HOUR=9

MAIL_INBOX=INBOX
# Доп. папки Graph (через запятую). junkemail — письма, попавшие в «Нежелательная почта»
MAIL_EXTRA_FOLDERS=junkemail
MAIL_DRAFTS=Drafts
STATE_FILE=scripts/.email_support_state.json

CATCHUP_MAX_DAYS=3
CATCHUP_BUFFER_HOURS=2
STALE_MAIL_ALERT_HOURS=4
INBOX_LOOKBACK_DAYS=14
IMAP_WAIT_SECONDS=120
OLLAMA_WAIT_SECONDS=60
OLLAMA_CHAT_TIMEOUT=180
OLLAMA_FEW_SHOT_MAX=2
# FAQ через playbook; Ollama только для неизвестных писем
OLLAMA_ENABLED=true
# Не слать второй авто-ответ тому же адресу раньше чем через N часов (0 = выкл.)
REPLY_COOLDOWN_HOURS=4
