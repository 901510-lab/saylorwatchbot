# Скопируйте: cp scripts/paper_wallet.example.env scripts/paper_wallet.env
# Бот должен быть админом @Paper_wallet_co с правом публикации.

# Токен больше не нужен на сервере — используется BOT_TOKEN из .env.
# Локальный CLI: можно задать BOT_TOKEN в .env или здесь.

PAPER_WALLET_ENABLED=true
# Канал
PAPER_WALLET_CHANNEL=@Paper_wallet_co

# Расписание (systemd timer читает POST_HOUR/MINUTE)
PAPER_WALLET_TIMEZONE=Europe/Moscow
PAPER_WALLET_POST_HOUR=12
PAPER_WALLET_POST_MINUTE=00

# Сколько монет в каждой таблице (случайно в диапазоне min–max)
PAPER_WALLET_TOP_MIN=8
PAPER_WALLET_TOP_MAX=10
PAPER_WALLET_BOTTOM_MIN=8
PAPER_WALLET_BOTTOM_MAX=10

# «Хвост»: только монеты с объёмом ≥ USD за 24h
PAPER_WALLET_MIN_VOLUME_USD=100000

# Реклама SaylorWatch (середина + footer на картинках)
PAPER_WALLET_BOT_LINK=https://t.me/Saylor_w_bot
PAPER_WALLET_BOT_NAME=SaylorWatch

# Опционально: CoinGecko Demo API key (если rate limit)
# COINGECKO_API_KEY=

# State (не постить дважды за день)
# PAPER_WALLET_STATE_FILE=scripts/.paper_wallet_state.json
