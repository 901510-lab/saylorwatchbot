# Telegram bot token from @BotFather.
BOT_TOKEN=123456789:replace-with-your-token

# Telegram user/chat id allowed to run admin commands and receive alerts.
X_CHAT_ID=123456789

# Render provides PORT automatically. Keep this for local testing only.
PORT=10000

# Optional: how often holdings are checked, in seconds.
MONITOR_INTERVAL_SECONDS=900

# Optional: enable a Telegram alive ping every 6 hours.
ENABLE_ALIVE_PING=false

# Optional: custom path for the local holdings baseline file (legacy MVP; migrated to baselines/).
HOLDINGS_STATE_FILE=last_holdings.json

# Optional: directory for per-entity baseline files (Day 10 multi-whale).
# BASELINES_DIR=baselines

# Optional: minimum BTC change to trigger buy/sale alert (default 1).
MIN_BTC_CHANGE=1

# Optional: monitor strategy.com purchases & BTC press releases (default true).
ENABLE_STRATEGY_SITE=true

# Optional: link to your full Terms of Service / Privacy Policy page.
# Shown at the bottom of /disclaimer when set.
# Draft text to publish is in LEGAL.md — paste it into Telegra.ph or Notion,
# then put the resulting public URL here.
# LEGAL_URL=https://telegra.ph/SaylorWatch--Terms--Privacy-06-03

# Support / GDPR / payment issues (shown in /disclaimer).
SUPPORT_EMAIL=SaylorWatch@outlook.com

# Public website (Day 21+). Shown in /start and /help when set.
# Register domain: see DOMAIN.md
# SITE_URL=https://saylorwatch.io

# Optional: donation addresses for /donate (helps pay for the server).
# When set, a "Support the server" hint also appears in /start and /help.
# DONATE_BTC=bc1q-your-bitcoin-address
# DONATE_ETH=0xYourEthereumAddress
# DONATE_TON=UQYourTonAddress

# Partner referral links (Day 26, optional — skip if you don't want exchange signups).
# PARTNER_BINANCE_URL=...
# PARTNER_BYBIT_URL=...
# PARTNER_LEDGER_URL=...

# Social growth (Day 27). Shown in /social when set.
# BOT_PUBLIC_URL=https://t.me/Saylor_w_bot
# BOT_USERNAME=Saylor_w_bot
# SOCIAL_X_URL=https://x.com/your_handle
# SOCIAL_REDDIT_URL=https://www.reddit.com/r/SaylorWatch/
# SOCIAL_DISCORD_URL=https://discord.gg/jjXeeRDcu

# Optional: browser User-Agent if strategy.com returns 403 (default: Chrome on Windows).
# STRATEGY_SITE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ...

# Optional: Farside ETF daily flows page (Day 13). May require server-side fetch if Cloudflare blocks.
# FARSIDE_ETF_URL=https://farside.co.uk/btc/
# FARSIDE_ETF_URLS=https://farside.co.uk/btc/,https://farside.co.uk/bitcoin-etf-flow-all-data/
# FARSIDE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ...

# Fallback when Farside returns HTTP 403 from datacenter IPs (JustRunMy, Render, etc.).
# Required for weekly digest ETF block when Farside is blocked.
# Free key: https://openapi.sosovalue.com
# SOSOVALUE_API_KEY=your-sosovalue-api-key

# Subscription tiers (Day 16+). Gating activates on Day 19.
# PREMIUM_PRICE_USD=7
# FREE_ALERT_DELAY_MINUTES=15
# FREE_ALERT_QUEUE_FILE=free_alert_queue.json
# FREE_WEEKLY_STRATEGY_CARDS=1
# FREE_CARD_LARGE_BTC=100
# FREE_TIER_PERKS_FILE=free_tier_perks.json
# FREE_ALERT_CARD_CACHE_DIR=free_alert_card_cache
# FREE_WEEKLY_DIGEST_ENABLED=true

# Per-user subscription storage (Day 17). Created automatically.
# SUBSCRIBERS_FILE=subscribers.json

# Telegram Stars — Premium payment (Day 18). Digital goods in XTR only.
# ENABLE_STARS_PAYMENTS=true
# PREMIUM_STARS=350
# PREMIUM_BILLING_DAYS=30
# PAYMENTS_FILE=payments.json

# Founding promo — first N users get M days Premium free (no Stars).
# FOUNDING_PROMO_ENABLED=true
# FOUNDING_PROMO_MAX=100
# FOUNDING_PROMO_DAYS=365
# FOUNDING_PROMO_FILE=founding_promo.json

# Subscription alert gating (Day 19). false = legacy: only X_CHAT_ID
# ENABLE_SUBSCRIPTION_GATING=true

# Bot visit counters — unique users & /start count (Day 18+ analytics).
# BOT_STATS_FILE=bot_stats.json

# Weekly Digest — Premium PNG + Free text summary; DM every Sun 12:00 America/New_York + /weekly
# WEEKLY_DIGEST_ENABLED=true
# WEEKLY_DIGEST_TIMEZONE=America/New_York
# WEEKLY_DIGEST_WEEKDAY=6
# WEEKLY_DIGEST_HOUR=12
# WEEKLY_DIGEST_MINUTE=0
# WEEKLY_DIGEST_SNAPSHOT_FILE=weekly_digest_snapshot.json
# WEEKLY_DIGEST_STATE_FILE=weekly_digest_state.json
# TRANSACTIONS_FILE=transactions.json

# Premium expiry reminders — DM 3, 2 and 1 calendar days before expires_at (paid & founding).
# PREMIUM_EXPIRY_REMINDER_ENABLED=true
# PREMIUM_EXPIRY_REMINDER_DAYS=3,2,1
# PREMIUM_EXPIRY_REMINDER_TIMEZONE=America/New_York
# PREMIUM_EXPIRY_REMINDER_HOUR=10
# PREMIUM_EXPIRY_REMINDER_MINUTE=0
# PREMIUM_EXPIRY_REMINDER_STATE_FILE=subscription_expiry_reminders.json
# TRANSACTIONS_RETAIN_DAYS=90
# TRANSACTIONS_MAX_ENTRIES=2000

# Optional: per-user UI language preferences (created automatically).
# USER_LANG_FILE=user_languages.json

# Paper Wallet channel — daily CoinGecko tables @Paper_wallet_co (runs on server in main.py)
# Bot must be channel admin with post permission (same BOT_TOKEN is fine).
# PAPER_WALLET_ENABLED=true
# PAPER_WALLET_CHANNEL=@Paper_wallet_co
# PAPER_WALLET_TIMEZONE=Europe/Moscow
# PAPER_WALLET_POST_HOUR=12
# PAPER_WALLET_POST_MINUTE=0
# PAPER_WALLET_TOP_MIN=8
# PAPER_WALLET_TOP_MAX=10
# PAPER_WALLET_BOTTOM_MIN=8
# PAPER_WALLET_BOTTOM_MAX=10
# PAPER_WALLET_MIN_VOLUME_USD=100000
# PAPER_WALLET_BOT_LINK=https://t.me/Saylor_w_bot
# PAPER_WALLET_BOT_NAME=SaylorWatch
# PAPER_WALLET_STATE_FILE=paper_wallet_state.json

# Optional: state file for strategy.com uids (press / purchases).
STRATEGY_SITE_STATE_FILE=last_strategy_site.json
